# ─────────────────────────────────────────────────────────────────
# SECUREX AUTH - CONFIGURACIÓN DE VARIABLES DE ENTORNO
# ─────────────────────────────────────────────────────────────────

# URL Base de la aplicación
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Administrador Principal
ADMIN_BOOTSTRAP_EMAIL=spectralx@gmail.com
ADMIN_BOOTSTRAP_PASSWORD=SpectralX

# ── GOOGLE OAUTH 2.0 (OFICIAL) ──
# Obtén estas credenciales en https://console.cloud.google.com/apis/credentials
# URI de Redirección autorizada: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ── DISCORD OAUTH2 (OFICIAL) ──
# Obtén estas credenciales en https://discord.com/developers/applications
# URI de Redirección autorizada: http://localhost:3000/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback

# ── PAYPAL (TIENDA / UPGRADES) ──
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API=https://api-m.sandbox.paypal.com
